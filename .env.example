# EduBranch AI Environment Configuration

# Database (Microsoft SQL Server)
DATABASE_URL="sqlserver://localhost:1433;database=edubranch;user=sa;password=YOUR_DATABASE_PASSWORD;encrypt=true;trustServerCertificate=true"

# Security & Authentication
JWT_SECRET="REPLACE_WITH_RANDOM_JWT_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Admin Initial Seed Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
SEED_USER_PASSWORD="YOUR_SEED_USER_PASSWORD"
MSSQL_SA_PASSWORD="YOUR_DATABASE_PASSWORD"

# Admin Security Gate
ADMIN_LOCALHOST_ONLY=false

# AI / LLM Configuration (Mock / Live Integration)
AI_PROVIDER="mock" # or 'gemini' | 'openai'
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENAI_API_KEY="sk-YourOpenAiKeyHere"
LLM_MODEL="gemini-1.5-flash"
MAX_CHALLENGE_ROUNDS=2

# Server Ports
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

