{
  "name": "edubranch-ai",
  "version": "1.0.0",
  "private": true,
  "description": "EduBranch AI - Case-Based Learning Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build:shared": "npm run build --workspace=@edubranch/shared",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "seed": "npm run seed --workspace=apps/backend",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "case-based-learning",
    "branching-scenarios",
    "ai-challenge-support",
    "nextjs",
    "nestjs",
    "sqlserver"
  ],
  "author": "EduBranch AI Team",
  "license": "MIT"
}
